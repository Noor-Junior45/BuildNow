rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'mdhassan1738@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Connection Health Check
    match /test/{testDoc} {
      allow read: if true;
    }

    // Public Product Catalog
    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Customer Quick-Commerce Orders
    match /orders/{orderId} {
      allow read: if isAdmin() || (isSignedIn() && (existing().userId == request.auth.uid || existing().user_id == request.auth.uid));
      allow create: if isValidId(orderId)
        && incoming().id is string
        && incoming().customerName is string && incoming().customerName.size() <= 100
        && incoming().phone is string && incoming().phone.size() <= 25
        && incoming().totalAmount is number && incoming().totalAmount >= 0;
      allow update: if isValidId(orderId)
        && (incoming().totalAmount is number && incoming().totalAmount >= 0)
        && (!("status" in incoming()) || incoming().status in ['pending', 'accepted', 'packing', 'out_for_delivery', 'delivered', 'cancelled']);
      allow delete: if isAdmin();
    }

    // Real Estate & Apartment Wiring Service Bookings
    match /services_bookings/{bookingId} {
      allow read: if isAdmin() || (isSignedIn() && (existing().userId == request.auth.uid || existing().user_id == request.auth.uid));
      allow create: if isValidId(bookingId)
        && incoming().customerName is string && incoming().customerName.size() <= 100
        && incoming().phone is string && incoming().phone.size() <= 25;
      allow update: if isValidId(bookingId);
      allow delete: if isAdmin();
    }

    // User Profile Documents
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create, update: if isValidId(userId) && isOwner(userId) && (!("role" in incoming()) || incoming().role != "admin" || isAdmin());
      allow delete: if isOwner(userId) || isAdmin();
    }

    // Saved Addresses
    match /user_addresses/{addressId} {
      allow read: if isAdmin() || (isSignedIn() && existing().userId == request.auth.uid);
      allow create: if isSignedIn() && incoming().userId == request.auth.uid;
      allow update: if isSignedIn() && existing().userId == request.auth.uid && incoming().userId == request.auth.uid;
      allow delete: if isAdmin() || (isSignedIn() && existing().userId == request.auth.uid);
    }

    // Saved UPI Handles
    match /user_upi/{upiId} {
      allow read: if isAdmin() || (isSignedIn() && existing().userId == request.auth.uid);
      allow create: if isSignedIn() && incoming().userId == request.auth.uid;
      allow update: if isSignedIn() && existing().userId == request.auth.uid && incoming().userId == request.auth.uid;
      allow delete: if isAdmin() || (isSignedIn() && existing().userId == request.auth.uid);
    }
  }
}
